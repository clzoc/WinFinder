<Window x:Class="WinFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"        
        xmlns:local="clr-namespace:WinFinder" 
        xmlns:controls="clr-namespace:WinFinder.Controls"
        xmlns:utils="clr-namespace:WinFinder.Utilities"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        ResizeMode="NoResize"
        mc:Ignorable="d"
        Name="Root"              
        Title="MainWindow" 
        Icon="app-icon.ico"
        Height="902" 
        Width="1202"         
        WindowStyle="None"  
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#1418181B"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#ECECEE"/>
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#E4E4E7"/>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="IconBrush" Color="#18181B"/>
    </Window.Resources>
    <Grid Loaded="ContentView">
        <!--<Grid.Effect>
            <DropShadowEffect ShadowDepth="1" BlurRadius="0" Color="Black"/>
        
        </Grid.Effect>-->
        <Path x:Name="ClipPath" Stroke="Black" StrokeThickness="2.0" Data="{Binding ElementName=Root, Path=Info}"/>
        <Grid x:Name="LayoutRootParent" Clip="{Binding ElementName=ClipPath, Path=Data}" ClipToBounds="True" Margin="0,0,0,0" Background="{DynamicResource WindowBackgroundBrush}">
            <Grid x:Name="LayoutRoot" Margin="1,1,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="LayoutNodeTop" Grid.Row="0" Background="{DynamicResource TopBarBackgroundBrush}" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                    <Line x:Name="TopDivider" X1="0" Y1="0.5" X2="{Binding ElementName=LayoutNodeTop, Path=ActualWidth}" Y2="0.5" VerticalAlignment="Bottom" Stroke="{DynamicResource DividerBrush}" StrokeThickness="1"/>
                    <StackPanel x:Name="Traffic" Margin="13,13,0,0" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal">
                        <Button Click="Window_Close" FocusVisualStyle="{x:Null}" Margin="0,0,15,0" Width="20" Height="20" Background="{DynamicResource ControlBackgroundBrush}" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="20" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <svgc:SvgViewbox x:Name="Red">
                                <!--<svgc:SvgViewbox.Effect>
                                    <DropShadowEffect Direction="315" ShadowDepth="5" Color="#FC5753" Opacity="0.8" BlurRadius="25"/>
                                </svgc:SvgViewbox.Effect>-->
                                <svgc:SvgViewbox.Style>
                                    <Style TargetType="{x:Type svgc:SvgViewbox}">
                                        <Setter Property="Source" Value="/icon/Close_Button.svg"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=Traffic, Path=IsMouseOver}" Value="True">
                                                <Setter Property="Source" Value="/icon/Close_Button_Hover_M2.svg"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </svgc:SvgViewbox.Style>
                            </svgc:SvgViewbox>
                        </Button>
                        <Button Click="Window_Minim" FocusVisualStyle="{x:Null}" Margin="0,0,15,0" Width="20" Height="20" Background="{DynamicResource ControlBackgroundBrush}" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="20" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <svgc:SvgViewbox x:Name="Yellow">
                                <!--<svgc:SvgViewbox.Effect>
                                    <DropShadowEffect Direction="315" ShadowDepth="5" Color="#FDBC40" Opacity="0.8" BlurRadius="25"/>
                                </svgc:SvgViewbox.Effect>-->
                                <svgc:SvgViewbox.Style>
                                    <Style TargetType="{x:Type svgc:SvgViewbox}">
                                        <Setter Property="Source" Value="/icon/Minimize_Button.svg"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=Traffic, Path=IsMouseOver}" Value="True">
                                                <Setter Property="Source" Value="/icon/Minimize_Button_Hover_M.svg"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </svgc:SvgViewbox.Style>
                            </svgc:SvgViewbox>
                        </Button>
                        <Button Click="Window_Zoom" FocusVisualStyle="{x:Null}" Width="20" Height="20" Background="{DynamicResource ControlBackgroundBrush}" BorderThickness="0" >
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="20" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <svgc:SvgViewbox x:Name="Green">
                                <!--<svgc:SvgViewbox.Effect>
                                    <DropShadowEffect Direction="315" ShadowDepth="5" Color="#36C84B" Opacity="0.8" BlurRadius="25"/>
                                </svgc:SvgViewbox.Effect>-->
                                <svgc:SvgViewbox.Style>
                                    <Style TargetType="{x:Type svgc:SvgViewbox}">
                                        <Setter Property="Source" Value="/icon/Maximize_Button.svg"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=Traffic, Path=IsMouseOver}" Value="True">
                                                <Setter Property="Source" Value="{Binding Path=ZoomButton, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </svgc:SvgViewbox.Style>
                            </svgc:SvgViewbox>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="200,0,0,0" VerticalAlignment="Center">
                        <Grid ClipToBounds="False" Margin="0,0,0,0">
                            <!-- 添加阴影效果 -->
                            <Grid.Effect>
                                <DropShadowEffect Color="Black" Direction="315" ShadowDepth="0" BlurRadius="8" Opacity="0.5" />
                            </Grid.Effect>

                            <!-- 按钮内容 -->
                            <Button x:Name="PathBack" FocusVisualStyle="{x:Null}" Click="Window_Back" Margin="0,0,0,0" BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <controls:ThemedSvgIcon Height="20" Width="20" Source="/icon/left.svg" IconBrush="{DynamicResource IconBrush}"/>
                            </Button>
                        </Grid>

                        <Grid ClipToBounds="False" Margin="7,0,0,0">
                            <!-- 添加阴影效果 -->
                            <Grid.Effect>
                                <DropShadowEffect Color="Black" Direction="315" ShadowDepth="0" BlurRadius="8" Opacity="0.5" />
                            </Grid.Effect>
                            <Button x:Name="PathMove" FocusVisualStyle="{x:Null}" Click="Window_Retu" Margin="0,0,0,0" BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <controls:ThemedSvgIcon Height="20" Width="20" Source="/icon/right.svg" IconBrush="{DynamicResource IconBrush}"/>
                            </Button>
                        </Grid>

                        <Grid ClipToBounds="False" Margin="7,0,0,0">
                            <!-- 添加阴影效果 -->
                            <Grid.Effect>
                                <DropShadowEffect Color="Black" Direction="315" ShadowDepth="0" BlurRadius="8" Opacity="0.5" />
                            </Grid.Effect>
                            <Button x:Name="ViewListView" FocusVisualStyle="{x:Null}" Click="ViewListView_Click" Margin="0,0,0,0" BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <controls:ThemedSvgIcon Height="20" Width="20" Source="/icon/list.bullet.svg" IconBrush="{DynamicResource IconBrush}"/>
                            </Button>
                        </Grid>

                        <Grid ClipToBounds="False" Margin="7,0,0,0">
                            <!-- 添加阴影效果 -->
                            <Grid.Effect>
                                <DropShadowEffect Color="Black" Direction="315" ShadowDepth="0" BlurRadius="8" Opacity="0.5" />
                            </Grid.Effect>
                            <Button x:Name="ViewGridView" FocusVisualStyle="{x:Null}" Click="ViewGridView_Click" Margin="0,0,0,0" BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <controls:ThemedSvgIcon Height="20" Width="20" Source="/icon/rectangle.on.rectangle.svg" IconBrush="{DynamicResource IconBrush}"/>
                            </Button>
                        </Grid>

                        <Grid ClipToBounds="False" Margin="7,0,0,0">
                            <Grid.Effect>
                                <DropShadowEffect Color="Black" Direction="315" ShadowDepth="0" BlurRadius="8" Opacity="0.5" />
                            </Grid.Effect>
                            <Button x:Name="TogglePaneLayout" FocusVisualStyle="{x:Null}" Click="TogglePaneLayout_Click" Margin="0,0,0,0" BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <controls:ThemedSvgIcon Height="20" Width="20" Source="/icon/folder.svg" IconBrush="{DynamicResource IconBrush}"/>
                            </Button>
                        </Grid>

                        <Grid ClipToBounds="False" Margin="7,0,0,0">
                            <Grid.Effect>
                                <DropShadowEffect Color="Black" Direction="315" ShadowDepth="0" BlurRadius="8" Opacity="0.5" />
                            </Grid.Effect>
                            <Button x:Name="ToggleDualPane" FocusVisualStyle="{x:Null}" Click="ToggleDualPane_Click" Margin="0,0,0,0" BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <controls:ThemedSvgIcon Height="20" Width="20" Source="/icon/rectangle.on.rectangle.svg" IconBrush="{DynamicResource IconBrush}"/>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="currentFolderRegion" Background="Transparent" Width="720" Margin="10,0,0,0" Padding="10,0,10,0" TextWrapping="NoWrap" TextTrimming="WordEllipsis" FocusVisualStyle="{x:Null}" HorizontalAlignment="Left" Text="{Binding ElementName=Root, Path=CurrentFolder}" VerticalAlignment="Center" FontSize="21" FontWeight="Regular" FontFamily="Microsoft YaHei UI"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="LeftSideOutside" Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
                        <Line x:Name="LeftDivider" X1="0.5" Y1="0" X2="0.5" Y2="{Binding ElementName=LeftSideOutside, Path=ActualHeight}" HorizontalAlignment="Right" Stroke="{DynamicResource DividerBrush}" StrokeThickness="1"/>
                        <Grid x:Name="LeftSide">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="37"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{x:Static utils:LocalizationStrings.CommonPlacesTitle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Opacity="0.7" FontSize="18" FontFamily="Microsoft YaHei UI"/>
                            <Grid Grid.Row="1">
                                <Path x:Name="SideClip" Data="{Binding ElementName=Root, Path=SideClipInfo}"/>
                                <StackPanel x:Name="SideBar" Margin="6,0,6,10" Orientation="Vertical"/>
                            </Grid>
                            <Grid Grid.Row="2" Margin="6,0,6,7" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ModeAutoButton" Click="ModeAuto_Click" Grid.Column="0" Margin="0,0,0,0" BorderThickness="0" FocusVisualStyle="{x:Null}" FontSize="13" FontFamily="Microsoft YaHei UI" Content="Auto">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ModeAutoBorder" Background="{TemplateBinding Background}" Padding="0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ModeAutoBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="ModeLightButton" Click="ModeLight_Click" Grid.Column="1" Margin="0,0,0,0" BorderThickness="0" FocusVisualStyle="{x:Null}" ToolTip="Light">
                                    <controls:ThemedSvgIcon Width="18" Height="18" Source="/icon/sun.svg" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ModeLightBorder" Background="{TemplateBinding Background}" Padding="0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ModeLightBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="ModeDarkButton" Click="ModeDark_Click" Grid.Column="2" Margin="0,0,0,0" BorderThickness="0" FocusVisualStyle="{x:Null}" ToolTip="Dark">
                                    <controls:ThemedSvgIcon Width="18" Height="18" Source="/icon/moon.svg" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ModeDarkBorder" Background="{TemplateBinding Background}" Padding="0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ModeDarkBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                    <Grid x:Name="PaneContainer" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="0"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="Pane1Host" Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" Background="#FBFBFC">
                            <controls:WorkspacePane x:Name="Pane1" />
                        </Grid>
                        <Grid x:Name="Pane2Host" Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" Background="#FBFBFC" Visibility="Collapsed">
                            <controls:WorkspacePane x:Name="Pane2" />
                        </Grid>
                        <Border x:Name="PaneDivider"
                                Grid.RowSpan="2"
                                Grid.ColumnSpan="2"
                                Background="{DynamicResource DividerBrush}"
                                IsHitTestVisible="False"
                                Panel.ZIndex="1"
                                Width="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

