                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="{x:Type ListViewItem}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Width" Value="115"/>
                                                        <Setter Property="Height" Value="150"/>
                                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                                        <Setter Property="Padding" Value="0,0,0,0"/>
                                                        <!--<Setter Property="Margin" Value="{Binding ElementName=RootPane, Path=GridSpaceInfo}"/>-->
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Clip" Value="{Binding Data, ElementName=GridInnerViewClip}"/>
                                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_MouseDoubleClickForListView"/>
                                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#9ABAE8"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="#2962D9"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <vwp:VirtualizingWrapPanel SpacingMode="BetweenItemsOnly" Focusable="False" VirtualizingPanel.IsContainerVirtualizable="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="200, 200" VirtualizingPanel.CacheLengthUnit="Pixel" Orientation="Horizontal" Margin="0,6,0,6"/>
                                                    </ItemsPanelTemplate>
                                                </ListView.ItemsPanel>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,0">
                                                            <Grid Margin="0,0,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="110"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Setter Property="Width" Value="115"/>
                                                                        <Setter Property="Height" Value="150"/>
                                                                        <Setter Property="Margin" Value="0,0,0,0"/>
                                                                        <!--<Setter Property="Margin" Value="{Binding ElementName=RootPane, Path=GridSpaceInfo}"/>-->
                                                                        <!--<Setter Property="Clip" Value="{Binding Data, ElementName=GridInnerViewClip}"/>-->
                                                                        <!--<EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_MouseClickForGrid"/>-->
                                                                        <!--<Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#9ABAE8"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>-->
                                                                    </Style>
                                                                </Grid.Style>
                                                                <Grid Grid.Row="0">
                                                                    <!--<Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#9ABAE8"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>-->
                                                                    <Image Source="{Binding S0, IsAsync=True}" Grid.Row="0" Width="110" Height="100" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                                        <Image.Effect>
                                                                            <DropShadowEffect Direction="315" ShadowDepth="0" Color="#bbbbbb" Opacity="1.0" BlurRadius="5"/>
                                                                        </Image.Effect>
                                                                    </Image>
                                                                </Grid>
                                                                <TextBlock Grid.Row="1" Margin="5,2,5,0" FontSize="14" FontFamily="Microsoft YaHei UI" Text="{Binding X0}" Tag="{Binding X2}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                                            </Grid>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
        
