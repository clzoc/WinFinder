        <Popup x:Name="BreadcrumbPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Placement="Bottom">
            <Border x:Name="BreadcrumbPopupBorder" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="4">
                <ScrollViewer x:Name="BreadcrumbScrollViewer" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
