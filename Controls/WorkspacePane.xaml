                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,0">
                                            <Path x:Name="GridViewClip" Stroke="{DynamicResource DividerBrush}" StrokeThickness="1" Data="{Binding ElementName=RootPane, Path=GridClipInfo}"/>
                                                            <Path x:Name="GridInnerViewClip" Data="{Binding ElementName=RootPane, Path=GridInnerClipInfo}"/>
                                                            <Grid Margin="0,0,0,0">
