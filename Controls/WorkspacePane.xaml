                                                                    </Style>
                                                                </Grid.Style>
                                                                <Image Source="{Binding S0, IsAsync=True}" Grid.Row="0" Width="105" Height="100" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                                    <Image.Effect>
                                                                        <DropShadowEffect Direction="270" ShadowDepth="1" Color="#bbbbbb" Opacity="1.0" BlurRadius="3"/>
                                                                    </Image.Effect>
                                                                </Image>
                                                                <TextBlock Grid.Row="1" Margin="5,0,5,0" FontSize="15" FontFamily="Microsoft YaHei UI" Text="{Binding X0}" Tag="{Binding X2}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                                            </Grid>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </vwp:VirtualizingItemsControl>-->
                                        </Grid>
                                    </Grid>
                                    
                                    <Grid Grid.Row="1">
                                        <Line x:Name="InfoDivider" X1="0" Y1="0.5" X2="{Binding ElementName=pwdRegion, Path=ActualWidth}" Y2="0.5" VerticalAlignment="Top" Stroke="{DynamicResource DividerBrush}" StrokeThickness="1"/>
                                        <TextBlock x:Name="ExtraInfo" Margin="0,0,0,0" Padding="10,0,10,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FocusVisualStyle="{x:Null}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Regular" FontFamily="Microsoft YaHei UI"></TextBlock>
