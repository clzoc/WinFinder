<UserControl x:Class="WinFinder.Controls.WorkspacePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WinFinder.Controls"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d" 
             x:Name="RootPane"
             x:ClassModifier="public"
             d:DesignHeight="300" d:DesignWidth="300">

    <Grid x:Name="WorkSpace">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="39"/>
                                    </Grid.RowDefinitions>
                                    <Path x:Name="FileClip" Data="{Binding ElementName=RootPane, Path=ClipInfo}"/>
                                    <!--<Path x:Name="GridViewClip" Data="{Binding ElementName=RootPane, Path=GridClipInfo}"/>-->
                                    <Grid x:Name="ContentArea" Grid.Row="0" ClipToBounds="True" Background="#FFFFFF" IsHitTestVisible="True" MouseWheel="ContentArea_MouseWheel" MouseDown="ContentGrid_MouseDown" MouseMove="ContentGrid_MouseMove" MouseUp="ContentGrid_MouseUp">
                                        <Line Canvas.ZIndex="1" x:Name="headerline" X1="0" Y1="0.5" X2="{Binding ElementName=pwdRegion, Path=ActualWidth}" Y2="0.5"  VerticalAlignment="Top" Margin="0,29,0,0" Stroke="{DynamicResource DividerBrush}" StrokeThickness="1"/>
                                        <Grid Margin="0,0,0,0">
                                            <Grid x:Name="RefGrid">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" x:Name="late0"/>
                                                <Grid Grid.Column="1" x:Name="late1"/>
                                                <Grid Grid.Column="2" x:Name="late2"/>
                                                <Grid Grid.Column="3" x:Name="late3"/>
                                            </Grid>
                                            <ListView Name="FILEINFOMATION" FocusVisualStyle="{x:Null}" ScrollViewer.ScrollChanged="ForScrollChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.CacheLength="200, 200" VirtualizingPanel.CacheLengthUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" Margin="0,0,0,0" Padding="6,0,6,0" Width="{Binding ActualWidth, ElementName=RefGrid}"  GridViewColumnHeader.Click="GridViewColumnHeader_Click" BorderThickness="0" AlternationCount="2" HorizontalAlignment="Left">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="{x:Type ListViewItem}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                                                                        <GridViewRowPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Margin" Value="0,0,0,0"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Height" Value="30"/>
                                                        <Setter Property="Foreground" Value="#000000"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Clip" Value="{Binding Data, ElementName=FileClip}"/>
                                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_MouseDoubleClickForListView"/>
                                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="ListView.AlternationIndex" Value="1">
                                                                <Setter Property="Background" Value="#F5F5F5"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#9ABAE8"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="#2962D9"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Width="{Binding ActualWidth, ElementName=late0}">
                                                            <GridViewColumnHeader Height="30" Background="Transparent">
                                                                <GridViewColumnHeader.Style>
                                                                    <Style TargetType="{x:Type GridViewColumnHeader}">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                                                                    <Border Background="{TemplateBinding Background}">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <!--<Setter Property="Visibility" Value="Collapsed"/>-->
                                                                    </Style>
                                                                </GridViewColumnHeader.Style>
                                                                <TextBlock Text="名称" FontSize="15" FontFamily="Microsoft YaHei UI" FontWeight="Bold" Margin="10,0,0,0"/>
                                                            </GridViewColumnHeader>
                                                            <GridViewColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Image Source="{Binding S0, IsAsync=True}" Width="25" Height="25">
                                                                            <Image.Effect>
                                                                                <DropShadowEffect Direction="315" ShadowDepth="0" Color="#bbbbbb" Opacity="0.8" BlurRadius="1"/>
                                                                            </Image.Effect>
                                                                        </Image>
                                                                        <TextBlock Text="{Binding X0}" Margin="5,0,0,0" FontSize="15" FontFamily="Microsoft YaHei UI" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </GridViewColumn.CellTemplate>
                                                        </GridViewColumn>
                                                        <GridViewColumn Width="{Binding ActualWidth, ElementName=late1}">
                                                            <GridViewColumnHeader Height="30" Background="Transparent">
                                                                <GridViewColumnHeader.Style>
                                                                    <Style TargetType="{x:Type GridViewColumnHeader}">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                                                                    <Border Background="{TemplateBinding Background}">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <!--<Setter Property="Visibility" Value="Collapsed"/>-->
                                                                    </Style>
                                                                </GridViewColumnHeader.Style>
                                                                <TextBlock Text="日期" FontSize="15" FontFamily="Microsoft YaHei UI" FontWeight="Bold" Margin="12,0,0,0"/>
                                                            </GridViewColumnHeader>
                                                            <GridViewColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock FontFamily="Maple Mono NF CN" Text="{Binding X1}" FontSize="15" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                                                                </DataTemplate>
                                                            </GridViewColumn.CellTemplate>
                                                        </GridViewColumn>
                                                        <GridViewColumn Width="{Binding ActualWidth, ElementName=late2}">
                                                            <GridViewColumnHeader Height="30" Background="Transparent">
                                                                <GridViewColumnHeader.Style>
                                                                    <Style TargetType="{x:Type GridViewColumnHeader}">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                                                                    <Border Background="{TemplateBinding Background}">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <!--<Setter Property="Visibility" Value="Collapsed"/>-->
                                                                    </Style>
                                                                </GridViewColumnHeader.Style>
                                                                <TextBlock Text="类型" FontSize="15" FontFamily="Microsoft YaHei UI" FontWeight="Bold" Margin="12,0,0,0"/>
                                                            </GridViewColumnHeader>
                                                            <GridViewColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding X2}" FontFamily="Maple Mono NF CN" FontSize="15" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                                                                </DataTemplate>
                                                            </GridViewColumn.CellTemplate>
                                                        </GridViewColumn>
                                                        <GridViewColumn Width="{Binding ActualWidth, ElementName=late3}">
                                                            <GridViewColumnHeader Height="30" Background="Transparent">
                                                                <GridViewColumnHeader.Style>
                                                                    <Style TargetType="{x:Type GridViewColumnHeader}">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                                                                    <Border Background="{TemplateBinding Background}">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <!--<Setter Property="Visibility" Value="Collapsed"/>-->
                                                                    </Style>
                                                                </GridViewColumnHeader.Style>
                                                                <TextBlock Text="大小" FontSize="15" FontFamily="Microsoft YaHei UI" FontWeight="Bold" Margin="0,0,0,0"/>
                                                            </GridViewColumnHeader>
                                                            <GridViewColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding X3[0]}" FontFamily="Maple Mono NF CN" FontSize="15" Tag="{Binding X4}" Margin="0,0,46,0" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7"/>
                                                                        <TextBlock Text="{Binding X3[1]}" FontFamily="Maple Mono NF CN" FontSize="15" Margin="66,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.7"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </GridViewColumn.CellTemplate>
                                                        </GridViewColumn>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
        
                                            <Path x:Name="GridInnerViewClip" Data="{Binding ElementName=RootPane, Path=GridInnerClipInfo}"/>
                                            <ListView x:Name="GridViewContainer" Visibility="Collapsed" FocusVisualStyle="{x:Null}" ScrollViewer.ScrollChanged="ForScrollChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.CacheLength="200, 200" VirtualizingPanel.CacheLengthUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" Margin="0,0,0,0" Padding="5,0,5,0" Width="{Binding ActualWidth, ElementName=RefGrid}" BorderThickness="0">
